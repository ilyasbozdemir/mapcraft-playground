<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
<xs:element name="kml">
  <xs:complexType>
    <xs:sequence>
      <xs:element name="Document">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="name" type="xs:string" minOccurs="0"/>
            <xs:element name="open" type="xs:decimal" minOccurs="0"/>
            <xs:element name="Folder">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="name" type="xs:string" minOccurs="0"/>
                  <xs:element name="Placemark" minOccurs="0" maxOccurs="unbounded">
            
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="name" type="xs:decimal" minOccurs="0"/>
                  <xs:element name="styleUrl" type="xs:string" minOccurs="0"/>
                  <xs:element name="Polygon">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="outerBoundaryIs">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="LinearRing">
                                <xs:complexType>
                                  <xs:sequence>
                                    <xs:element name="coordinates" type="xs:string" minOccurs="0"/>
                                  </xs:sequence>
                                </xs:complexType>
                              </xs:element>
                            </xs:sequence>
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="extrude" type="xs:decimal" minOccurs="0"/>
                        <xs:element name="altitudeMode" type="xs:string" minOccurs="0"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  <xs:element name="LookAt">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="longitude" type="xs:decimal" minOccurs="0"/>
                        <xs:element name="latitude" type="xs:string" minOccurs="0"/>
                        <xs:element name="range" type="xs:decimal" minOccurs="0"/>
                        <xs:element name="tilt" type="xs:decimal" minOccurs="0"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  <xs:element name="Style">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="PolyStyle">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="fill" type="xs:decimal" minOccurs="0"/>
                            </xs:sequence>
                          </xs:complexType>
                        </xs:element>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
                <xs:attribute name="id" type="xs:string" use="optional"/>
              </xs:complexType>
                  </xs:element>
                  <xs:element name="LookAt">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="longitude" type="xs:decimal" minOccurs="0"/>
                        <xs:element name="latitude" type="xs:decimal" minOccurs="0"/>
                        <xs:element name="range" type="xs:decimal" minOccurs="0"/>
                        <xs:element name="tilt" type="xs:decimal" minOccurs="0"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="xmlns" type="xs:string" use="optional"/>
    <xs:attribute name="xmlns:kml" type="xs:string" use="optional"/>
    <xs:attribute name="xmlns:gx" type="xs:string" use="optional"/>
    <xs:attribute name="xmlns:atom" type="xs:string" use="optional"/>
  </xs:complexType>
</xs:element>
</xs:schema>